APP_NAME=Content AI Backend
APP_VERSION=0.1.0
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRE_MINUTES=60
ADMIN_INVITE_CODE=replace-with-admin-code
YOUTUBE_API_KEY=
YOUTUBE_REGION=TH
GOOGLE_REGION=TH
TIKTOK_REGION=TH
LIVE_TREND_REFRESH_SECONDS=60
LIVE_TREND_LIMIT=50
LIVE_TREND_PROVIDER_TIMEOUT_SECONDS=8
LIVE_TREND_SNAPSHOT_RETENTION_RUNS=120
LIVE_TREND_MOMENTUM_WINDOW_SECONDS=300
YOUTUBE_CATEGORY_TREND_REFRESH_SECONDS=60
YOUTUBE_CATEGORY_TREND_LIMIT=50
YOUTUBE_CATEGORY_CACHE_SECONDS=86400
YOUTUBE_CATEGORY_SNAPSHOT_TIMEOUT_SECONDS=60
YOUTUBE_TREND_CATEGORY_IDS=1,2,10,15,17,20,22,23,24,25,26,28

# Production/demo ASR: download once with scripts/setup_faster_whisper.py,
# then run inference from the verified local directory without runtime downloads.
ASR_MODEL_SIZE=small
ASR_MODEL_DIR=models_cache/faster_whisper
ASR_LOCAL_FILES_ONLY=1
ASR_REQUIRE_MODEL_READY=1
ASR_LANGUAGE=auto
ANALYZE_ENABLE_THAI_SPELL_CORRECTION=0
ANALYZE_ENABLE_ML_KEYWORDS=0
ANALYZE_ENABLE_VISUAL=0
NLP_USE_PYTHAINLP=0

# Use mysql or sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=content_ai
DB_USER=root
DB_PASSWORD=1234

# Or use a full SQLAlchemy URL directly
# DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/content_ai
