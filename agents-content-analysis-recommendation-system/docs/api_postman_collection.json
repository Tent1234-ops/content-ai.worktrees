{
  "info": {
    "name": "Content Trend Analysis API",
    "description": "Postman collection สำหรับ backend ระบบวิเคราะห์คอนเทนต์: auth, upload, recommendation, dashboard, trends, follows, notifications, admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "<user_access_token>",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "<admin_access_token>",
      "type": "string"
    },
    {
      "key": "content_id",
      "value": "<saved_content_id>",
      "type": "string"
    },
    {
      "key": "follow_topic_id",
      "value": "<follow_topic_id>",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "<notification_id>",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth / Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"creator_demo\",\n  \"email\": \"creator_demo@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"creator_demo@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Auth / Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Analyze / Save Upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "<path-to-video-file>"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/analyze/save",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "analyze",
            "save"
          ]
        }
      }
    },
    {
      "name": "My Ideas / Content History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/contents/my?limit=20&offset=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "contents",
            "my"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "name": "Content Detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/contents/{{content_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "contents",
            "{{content_id}}"
          ]
        }
      }
    },
    {
      "name": "Recommendation / From Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"รีวิวมือถือใหม่\",\n  \"text\": \"รีวิวมือถือใหม่ ฟีเจอร์กล้องชัด แบตอึด\",\n  \"source\": \"youtube\",\n  \"profile_limit\": 120\n}"
        },
        "url": {
          "raw": "{{base_url}}/recommendations/from-text",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "recommendations",
            "from-text"
          ]
        }
      }
    },
    {
      "name": "Recommendation / From Saved Content",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/recommendations/from-content/{{content_id}}?source=youtube&profile_limit=150",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "recommendations",
            "from-content",
            "{{content_id}}"
          ],
          "query": [
            {
              "key": "source",
              "value": "youtube"
            },
            {
              "key": "profile_limit",
              "value": "150"
            }
          ]
        }
      }
    },
